
# Local Terraform directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable files (may contain sensitive data)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*tfplan*

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Terragrunt cache
.terragrunt-cache/

# Testing directory
testing/
